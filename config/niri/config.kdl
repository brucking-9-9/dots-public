spawn-at-startup "waybar"
spawn-at-startup "awww-daemon"
spawn-at-startup "@POLKIT_GNOME@/libexec/polkit-gnome-authentication-agent-1"
spawn-at-startup "nm-applet"

// awww remembers whichever image you last set, so this really only
// matters once. Drop an image at the path below (or point it elsewhere)
// — the "sleep" is a best-effort wait for the daemon socket above to be
// ready; bump it if the wallpaper doesn't apply on boot. Comment this
// line out entirely if you'd rather keep the plain background-color
// from the output block below.
// The bottom bar's wallpaper strip (home/modules/bar/quickshell-bottom.nix)
// writes the chosen image to ~/.local/state/wallpaper/current; fall back to
// the default png until it has been used once.
spawn-sh-at-startup "sleep 0.5 && awww img \"$(cat ~/.local/state/wallpaper/current 2>/dev/null || echo ~/Pictures/Wallpapers/wallpaper.png)\" --transition-type wipe --transition-fps 60"

output "eDP-1" {
  //W 290mm H 180mm
  background-color "#120b10"
  position x=0 y=0
}

output "DP-2" {
  //W 1420mm H 800mm
  scale 1
  // position x=731 y=915
}
prefer-no-csd

// Xwayland: use the pinned xwayland-satellite build from wm/niri.nix (Steam
// dropdown fix, see the comment there). Path substituted at build time.
xwayland-satellite {
  path "@XWAYLAND_SATELLITE@/bin/xwayland-satellite"
}

// ── Layout ───────────────────────────────────────────────────────────
// Corners are deliberately left square — no geometry-corner-radius rule
// below — to match the sharp-corner look already set in fuzzel and
// mako. Gaps + an amber focus ring + a soft drop shadow give it depth
// without fighting that.
layout {
  gaps 10

  // Bottom bar (home/modules/bar/quickshell-bottom.nix): its minimized
  // islands are 22 px tall and sit on the bottom edge, so reserve room for
  // them below the windows and pull the windows up under waybar by most of
  // that (leaves a 2 px gap under the top bar instead of 10).
  struts {
    top -8
    bottom 14
  }


  focus-ring {
    width 2
    active-color "#00ffc8"
    inactive-color "#563466"
  }
 preset-window-heights {
        proportion 0.33333
        proportion 0.5
        fixed 720
        proportion 0.9999999
    }
  // border {
  //   off
  // }

  shadow {
    on
    softness 24
    spread 2
    offset x=0 y=3
    color "#00000090"
  }
}

// ── Window rules ─────────────────────────────────────────────────────
// Open Firefox's picture-in-picture player floating instead of tiled.
window-rule {
  match app-id=r#"firefox$"# title="^Picture-in-Picture$"
  open-floating true
}

// Small utility popups (polkit prompt, volume mixer) should float
// rather than get pulled into the scrolling column layout.
window-rule {
  match app-id=r#"^authentication-agent-1$"#
  match app-id=r#"^pwvucontrol$"#
  open-floating true
}
window-rule {
    match app-id=r#"^cs2$"#
    open-fullscreen true
}
window-rule {

  default-column-width {fixed 800;}
  default-window-height {fixed 720;}
}
// ── Animations ───────────────────────────────────────────────────────
// A little snappier than niri's stock timings. Full reference:
// https://github.com/niri-wm/niri/wiki/Configuration:-Animations
animations {
  window-open {
    duration-ms 150
    curve "ease-out-expo"
  }
  window-close {
    duration-ms 130
    curve "ease-out-quad"
  }
  workspace-switch {
    spring damping-ratio=0.95 stiffness=1000 epsilon=0.0001
  }
  window-movement {
    spring damping-ratio=0.95 stiffness=800 epsilon=0.0001
  }
  horizontal-view-movement {
    spring damping-ratio=0.95 stiffness=800 epsilon=0.0001
  }
}

// Spotify visualizer window (spotify-viz, terminal/spotify-player.nix):
// small floating kitty window parked in the top-left corner
window-rule {
  match app-id=r#"^spotify-viz$"#
  open-floating true
  default-floating-position x=16 y=16 relative-to="top-left"
  // ~72x12 kitty cells at this output's scale; the catch-all rule below
  // would otherwise force 800x720 on it
  default-column-width { fixed 700; }
  default-window-height { fixed 252; }
}

// Spotify mini player overlay (kitten panel, namespace spotify-mini)
layer-rule {
  match namespace=r#"^spotify-mini$"#
  geometry-corner-radius 12
  shadow { on; }
}

binds {
  Mod+Shift+Slash { show-hotkey-overlay; }

  // Terminal & launcher
  Mod+Return  { spawn "kitty"; }
  // Spotify mini player overlay (kitten panel; terminal/spotify-player.nix) — toggles
  Mod+M { spawn "spotify-mini"; }
  Mod+Shift+M { spawn "spotify-mini" "--kill"; }
  // zellij must run inside a terminal — spawning the bare shell gave it no
  // tty, so this launches kitty and hands it the zellij attach command.
  Mod+Shift+Return { spawn "kitty" "zsh" "-c" "zellij attach -c main"; }
  // Claude Code, also inside a kitty window.
  Mod+Alt+Return   { spawn "kitty" "claude"; }
  // Run / calculate prompt (fuzzel): a shell command runs; a math
  // expression (or one prefixed with =) is calculated and copied.
  Mod+Shift+D { spawn "sh" "-c" "$HOME/.local/bin/launch"; }
  // Caffeine — toggle idle inhibition so swaylock/sleep won't fire.
  Mod+Shift+C { spawn "sh" "-c" "$HOME/.local/bin/caffeine"; }
  // Bottom bar (quickshell, home/modules/bar/quickshell-bottom.nix):
  // Mod+D summons the launcher alone — the apps island centred near the
  // bottom with the prompt focused, on the overlay layer so it also shows
  // over a fullscreen window; Esc, Mod+D again, or launching closes it.
  // (fuzzel is still installed: Mod+Shift+D and the cliphist picker use it.)
  Mod+D       { spawn "qs" "ipc" "-c" "bottom" "call" "bar" "summon"; }
  // Mod+B raises the whole HUD (apps + media + sys) with the prompt focused;
  // Esc or Mod+B again closes it.
  Mod+B       { spawn "qs" "ipc" "-c" "bottom" "call" "bar" "toggle"; }
  // Mod+Shift+N toggles mako's do-not-disturb mode (popups hidden, ✉ still counts).
  Mod+Shift+N { spawn "qs" "ipc" "-c" "bottom" "call" "bar" "dnd"; }
  Mod+E       { spawn "nemo"; }
  // -f forks to background; colour comes from programs.swaylock.settings
  Super+Alt+L { spawn "swaylock" "-f"; }
  // Power menu — lock / logout / suspend / reboot / shutdown
  Mod+Shift+Escape { spawn "wlogout"; }

  // Screenshots (grim + slurp), piped through swappy to annotate,
  // then save or copy from there.
  Print      { spawn "sh" "-c" "grim - | swappy -f -"; }
  Ctrl+Print { spawn "sh" "-c" "grim -g \"$(slurp)\" - | swappy -f -"; }
  Alt+Print  { screenshot-window; }

  // Audio — swayosd-client performs the change AND shows an on-screen
  // popup, so it replaces the old direct wpctl calls.
  XF86AudioRaiseVolume allow-when-locked=true { spawn "swayosd-client" "--output-volume" "raise"; }
  XF86AudioLowerVolume allow-when-locked=true { spawn "swayosd-client" "--output-volume" "lower"; }
  XF86AudioMute        allow-when-locked=true { spawn "swayosd-client" "--output-volume" "mute-toggle"; }
  XF86AudioMicMute                            { spawn "swayosd-client" "--input-volume"  "mute-toggle"; }

  // Media playback — playerctl drives the active MPRIS player. Allowed on
  // the lock screen so you can skip tracks without unlocking.
  XF86AudioPlay  allow-when-locked=true { spawn "playerctl" "play-pause"; }
  XF86AudioPause allow-when-locked=true { spawn "playerctl" "play-pause"; }
  XF86AudioNext  allow-when-locked=true { spawn "playerctl" "next"; }
  XF86AudioPrev  allow-when-locked=true { spawn "playerctl" "previous"; }
  XF86AudioStop  allow-when-locked=true { spawn "playerctl" "stop"; }

  // Brightness — same deal, swayosd-client replaces brightnessctl here.
  // The screen backlight on this T2 machine is acpi_video0 (not
  // intel_backlight); --device and its value must be two separate args.
  XF86MonBrightnessUp   { spawn "swayosd-client" "--brightness" "raise" "--device" "acpi_video0"; }
  XF86MonBrightnessDown { spawn "swayosd-client" "--brightness" "lower" "--device" "acpi_video0"; }

  XF86KbdBrightnessUp   { spawn "sh" "-c" "brightnessctl -q -d apple::kbd_backlight set 10%+; b=$(brightnessctl -d apple::kbd_backlight -m | cut -d, -f3); i=medium; [ \"$b\" -eq 0 ] && i=off; [ \"$b\" -eq 512 ] && i=high; swayosd-client --custom-progress \"$(awk -v b=$b 'BEGIN{printf \"%.2f\", b/512}')\" --custom-icon keyboard-brightness-$i-symbolic"; }
  XF86KbdBrightnessDown { spawn "sh" "-c" "brightnessctl -q -d apple::kbd_backlight set 10%-; b=$(brightnessctl -d apple::kbd_backlight -m | cut -d, -f3); i=medium; [ \"$b\" -eq 0 ] && i=off; [ \"$b\" -eq 512 ] && i=high; swayosd-client --custom-progress \"$(awk -v b=$b 'BEGIN{printf \"%.2f\", b/512}')\" --custom-icon keyboard-brightness-$i-symbolic"; }

  Mod+Q { close-window; }

  // Focus — arrow keys and hjkl
  Mod+Left  { focus-column-left; }
  Mod+Down  { focus-window-down; }
  Mod+Up    { focus-window-up; }
  Mod+Right { focus-column-right; }
  Mod+H     { focus-column-left; }
  Mod+J     { focus-window-down; }
  Mod+K     { focus-window-up; }
  Mod+L     { focus-column-right; }

  // Focus monitor
  Mod+Ctrl+Left  { focus-monitor-left; }
  Mod+Ctrl+Down  { focus-monitor-down; }
  Mod+Ctrl+Up    { focus-monitor-up; }
  Mod+Ctrl+Right { focus-monitor-right; }
  Mod+Ctrl+H     { focus-monitor-left; }
  Mod+Ctrl+J     { focus-monitor-down; }
  Mod+Ctrl+K     { focus-monitor-up; }
  Mod+Ctrl+L     { focus-monitor-right; }

  // Move
  Mod+Shift+Left  { move-column-left; }
  Mod+Shift+Down  { move-window-down; }
  Mod+Shift+Up    { move-window-up; }
  Mod+Shift+Right { move-column-right; }
  Mod+Shift+H     { move-column-left; }
  Mod+Shift+J     { move-window-down; }
  Mod+Shift+K     { move-window-up; }
  Mod+Shift+L     { move-column-right; }

  // Move to monitor
  Mod+Ctrl+Shift+Left  { move-column-to-monitor-left; }
  Mod+Ctrl+Shift+Down  { move-column-to-monitor-down; }
  Mod+Ctrl+Shift+Up    { move-column-to-monitor-up; }
  Mod+Ctrl+Shift+Right { move-column-to-monitor-right; }
  Mod+Ctrl+Shift+H     { move-column-to-monitor-left; }
  Mod+Ctrl+Shift+J     { move-column-to-monitor-down; }
  Mod+Ctrl+Shift+K     { move-column-to-monitor-up; }
  Mod+Ctrl+Shift+L     { move-column-to-monitor-right; }

  // Workspaces
  Mod+Page_Down      { focus-workspace-down; }
  Mod+Page_Up        { focus-workspace-up; }
  Mod+U              { focus-workspace-down; }
  Mod+I              { focus-workspace-up; }
  Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
  Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }
  Mod+Ctrl+U         { move-column-to-workspace-down; }
  Mod+Ctrl+I         { move-column-to-workspace-up; }

  Mod+Shift+Page_Down { move-workspace-down; }
  Mod+Shift+Page_Up   { move-workspace-up; }
  Mod+Shift+U         { move-workspace-down; }
  Mod+Shift+I         { move-workspace-up; }

  Mod+Home      { focus-column-first; }
  Mod+End       { focus-column-last; }
  Mod+Ctrl+Home { move-column-to-first; }
  Mod+Ctrl+End  { move-column-to-last; }

  Mod+1 { focus-workspace 1; }
  Mod+2 { focus-workspace 2; }
  Mod+3 { focus-workspace 3; }
  Mod+4 { focus-workspace 4; }
  Mod+5 { focus-workspace 5; }
  Mod+6 { focus-workspace 6; }
  Mod+7 { focus-workspace 7; }
  Mod+8 { focus-workspace 8; }
  Mod+9 { focus-workspace 9; }

  Mod+Shift+1 { move-column-to-workspace 1; }
  Mod+Shift+2 { move-column-to-workspace 2; }
  Mod+Shift+3 { move-column-to-workspace 3; }
  Mod+Shift+4 { move-column-to-workspace 4; }
  Mod+Shift+5 { move-column-to-workspace 5; }
  Mod+Shift+6 { move-column-to-workspace 6; }
  Mod+Shift+7 { move-column-to-workspace 7; }
  Mod+Shift+8 { move-column-to-workspace 8; }
  Mod+Shift+9 { move-column-to-workspace 9; }

  // Bottom-bar pins by number (the chips are numbered 1-9 in the launcher):
  // Mod+Alt+N focuses the pinned app or launches it, Mod+Alt+Shift+N
  // SIGKILLs it — no launcher, no animation. The list itself lives in
  // ~/.local/state/quickshell-bottom/pins.json (right-click a chip to edit).
  Mod+Alt+1 { spawn "qs" "ipc" "-c" "bottom" "call" "bar" "pin" "1"; }
  Mod+Alt+2 { spawn "qs" "ipc" "-c" "bottom" "call" "bar" "pin" "2"; }
  Mod+Alt+3 { spawn "qs" "ipc" "-c" "bottom" "call" "bar" "pin" "3"; }
  Mod+Alt+4 { spawn "qs" "ipc" "-c" "bottom" "call" "bar" "pin" "4"; }
  Mod+Alt+5 { spawn "qs" "ipc" "-c" "bottom" "call" "bar" "pin" "5"; }
  Mod+Alt+6 { spawn "qs" "ipc" "-c" "bottom" "call" "bar" "pin" "6"; }
  Mod+Alt+7 { spawn "qs" "ipc" "-c" "bottom" "call" "bar" "pin" "7"; }
  Mod+Alt+8 { spawn "qs" "ipc" "-c" "bottom" "call" "bar" "pin" "8"; }
  Mod+Alt+9 { spawn "qs" "ipc" "-c" "bottom" "call" "bar" "pin" "9"; }
  Mod+Alt+Shift+1 { spawn "qs" "ipc" "-c" "bottom" "call" "bar" "killpin" "1"; }
  Mod+Alt+Shift+2 { spawn "qs" "ipc" "-c" "bottom" "call" "bar" "killpin" "2"; }
  Mod+Alt+Shift+3 { spawn "qs" "ipc" "-c" "bottom" "call" "bar" "killpin" "3"; }
  Mod+Alt+Shift+4 { spawn "qs" "ipc" "-c" "bottom" "call" "bar" "killpin" "4"; }
  Mod+Alt+Shift+5 { spawn "qs" "ipc" "-c" "bottom" "call" "bar" "killpin" "5"; }
  Mod+Alt+Shift+6 { spawn "qs" "ipc" "-c" "bottom" "call" "bar" "killpin" "6"; }
  Mod+Alt+Shift+7 { spawn "qs" "ipc" "-c" "bottom" "call" "bar" "killpin" "7"; }
  Mod+Alt+Shift+8 { spawn "qs" "ipc" "-c" "bottom" "call" "bar" "killpin" "8"; }
  Mod+Alt+Shift+9 { spawn "qs" "ipc" "-c" "bottom" "call" "bar" "killpin" "9"; }

  Mod+Tab { focus-workspace-previous; }

  // Column / window management
  Mod+Comma  { consume-window-into-column; }
  Mod+Period { expel-window-from-column; }

  Mod+BracketLeft  { consume-or-expel-window-left; }
  Mod+BracketRight { consume-or-expel-window-right; }

  Mod+R       { switch-preset-column-width; }
  Mod+Shift+R { switch-preset-window-height; }
  Mod+Ctrl+R  { reset-window-height; }
  Mod+F       { maximize-column; }
  Mod+Shift+F { fullscreen-window; }
  Mod+C       { center-column; }

  Mod+Minus       { set-column-width "-10%"; }
  Mod+Equal       { set-column-width "+10%"; }
  Mod+Shift+Minus { set-window-height "-10%"; }
  Mod+Shift+Equal { set-window-height "+10%"; }

  Mod+V       { toggle-window-floating; }
  Mod+Shift+V { switch-focus-between-floating-and-tiling; }

  Mod+W { toggle-column-tabbed-display; }

  Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

  Mod+Shift+E { quit; }
  Mod+Shift+P { power-off-monitors; }
}
