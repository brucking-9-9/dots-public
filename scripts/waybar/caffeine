#!/usr/bin/env bash
# Caffeine — inhibit idle so the screen doesn't lock/sleep.
# In addition to a logind idle-inhibit, this stops the swayidle service,
# because swayidle (which fires `swaylock -f` on timeout) does NOT honour
# systemd-inhibit locks — so stopping it is what actually keeps swaylock away.

ACTION="" # "on", "off", "check", or empty (toggle)
WHAT="idle"

for arg in "$@"; do
    case "$arg" in
        --on) ACTION="on" ;;
        --off) ACTION="off" ;;
        --is-running) ACTION="check" ;;
        --help|-h)
            echo "Usage: $0 [--on|--off|--is-running] [what]"
            exit 0
        ;;
        *) WHAT="$arg" ;;
    esac
done

GREP="systemd-inhibit --what=${WHAT} sleep infinity"

is_running() {
    pgrep -f -- "$GREP" > /dev/null 2>&1;
}

start() {
    if is_running; then
        return
    fi

    # Stop the idle watcher so swaylock won't be triggered on timeout.
    systemctl --user stop swayidle.service 2>/dev/null

    notify-send -i my-caffeine-on-symbolic -a caffeine \
        "Caffeine on" "Screen won't lock or sleep"

    nohup bash -c "$GREP" >/dev/null 2>&1 &
}

stop() {
    if ! is_running; then
        # Make sure the idle watcher is running again even if we were half-on.
        systemctl --user start swayidle.service 2>/dev/null
        return
    fi

    # Restore the idle watcher (swaylock/auto-suspend resume).
    systemctl --user start swayidle.service 2>/dev/null

    notify-send -i my-caffeine-off-symbolic -a caffeine \
        "Caffeine off" "Idle lock and sleep re-enabled"

    pkill -f -- "$GREP"
}

if [[ "$ACTION" == "on" ]]; then
    start
elif [[ "$ACTION" == "off" ]]; then
    stop
elif [[ "$ACTION" == "check" ]]; then
    if is_running; then echo true; else echo false; fi
else
    if is_running; then stop; else start; fi
fi
